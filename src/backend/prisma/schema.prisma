// Prisma schema for the restaurant project.
//
// SQLite + Prisma. The database is a local file (see DATABASE_URL);
// never commit the *.db file. Run `npx prisma migrate dev` in src/backend.
//
// RELATIONSHIPS NOTE: MenuItem, TeamMember, NewsPost and ContactMessage are
// independent presentation lists with no foreign keys between them. A menu
// item is never owned by a team member, news posts do not reference menu
// items, and contact messages are standalone user input. Forcing relations
// here would add join cost with no real query benefit, so the models stay
// independent on purpose.
//
// I18N NOTE: fixed languages en/mk/sq use suffixed columns (e.g. nameEn,
// nameMk, nameSq) instead of a Translation table. Three languages are fixed
// by requirements, so joins are avoided and every localized read is a single
// row fetch. Proper nouns (TeamMember.name, NewsPost.slug) stay untranslated.

generator client {
  provider = "prisma-client-js"
  // Pinned so `prisma generate` produces the same engines on the host and
  // inside Docker (node:22-slim, Debian bookworm, OpenSSL 3). Without this,
  // engine auto-detection can resolve to openssl-1.1.x and the backend
  // crashes at startup with PrismaClientInitializationError.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Allowed category values (enforced at app level with Zod):
// starter | main | dessert | drink. Plain String keeps the schema simple;
// the API validates the value before writing.
model MenuItem {
  id          Int     @id @default(autoincrement())
  // See allowed values in the model comment above.
  category    String
  // Price as Float (SQLite has no Decimal type); validated positive at app level (Zod).
  price       Float
  imageUrl    String?
  isAvailable Boolean @default(true)
  nameEn      String
  nameMk      String
  nameSq      String
  descEn      String
  descMk      String
  descSq      String
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("menu_items")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  // Proper noun, untranslated.
  name      String
  roleEn    String
  roleMk    String
  roleSq    String
  bioEn     String
  bioMk     String
  bioSq     String
  photoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
  @@map("team_members")
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  // Language-neutral slug, e.g. winter-menu-2026.
  slug        String   @unique
  imageUrl    String?
  publishedAt DateTime @default(now())
  titleEn     String
  titleMk     String
  titleSq     String
  bodyEn      String
  bodyMk      String
  bodySq      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@map("news_posts")
}

// Stores raw user input as-is (monolingual, no translated columns).
// Intended lengths: name 2-80, subject <= 200 (validated at app level).
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}
