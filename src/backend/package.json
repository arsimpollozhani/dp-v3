    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "~5.5.4"
  }
